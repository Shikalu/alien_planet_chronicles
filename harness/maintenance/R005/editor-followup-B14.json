  "records": [
    {
      "sequence": 1,
      "chapter": 132,
      "path": "异星录/06_执行计划/工作区/R005-B14/第132章_谁在里头换班.md",
      "initial_issue_ids": [
        "R005-B14-I08"
      ],
      "before": "动手之前，林渡把镜片的用法对众人交代了一遍：镜面朝上吊下去，明早换灯照，看镜面的朝向变没变。变了，说明有人碰过；朝向对着哪边，说明那人想看什么。一面旧镜片，几尺细绳，是最不惊动人的探问。",
      "after": "动手之前，林渡把镜片的用法对众人交代了一遍：镜面朝上吊下去，明早换灯照，看镜面的朝向变没变。若有变化，先记下朝向；只凭镜片变了，还不能断定有人碰过，更不能据它朝哪边认定里头的人想看什么。一面旧镜片，几尺细绳，先留作一处待核的记号。",
      "reason": "撤镜片移动独证有人、朝向独证意图的断言，限于待核变化；不改镜片姿态、石缝宽度、落点或照明几何。",
      "review_v1_paragraph_index_zero_based_including_heading": 35,
      "applied_paragraph_index_zero_based_including_heading": 35,
      "operation": "replace_paragraph",
      "before_sha256": "7e01215e1ab838a233a17ac9a521d0a112c882e22458c22291ca0896252a3602",
      "after_sha256": "5defaaef2eafae78b614c6fa4e00bdd2ed03d8987b6088306720ed5ead034c15",
      "han_delta": 21
    },
    {
      "sequence": 2,
      "chapter": 132,
      "path": "异星录/06_执行计划/工作区/R005-B14/第132章_谁在里头换班.md",
      "initial_issue_ids": [
        "R005-B14-I08"
      ],
      "before": "“不撤主撑，不多敲。”他对众人说，“镜片在，明天看它有没有被挪动。挪了，说明里头有人到了缝边；不挪，我们再等。”",
      "after": "“不撤主撑，不多敲。”他对众人说，“镜片在，明天看它有没有被挪动。挪了，把变化记下来，等回敲时再核；不挪，我们再等。”",
      "reason": "将挪动即有人到了缝边降为后续待核，不新增检验结果，不补镜片几何。",
      "review_v1_paragraph_index_zero_based_including_heading": 37,
      "applied_paragraph_index_zero_based_including_heading": 37,
      "operation": "replace_paragraph",
      "before_sha256": "5defaaef2eafae78b614c6fa4e00bdd2ed03d8987b6088306720ed5ead034c15",
      "after_sha256": "57c290c3778b783c46968768cb44bf9a27bdc521e74f42bb5cbd7f8f115e7818",
      "han_delta": 2
    },
    {
      "sequence": 3,
      "chapter": 133,
      "path": "异星录/06_执行计划/工作区/R005-B14/第133章_孔里先过空气.md",
      "initial_issue_ids": [
        "R005-B14-I03",
        "R005-B14-I10"
      ],
      "before": "砖整块取出来的那一刻，一股气流从孔里缓缓淌出来——温的，带着一点潮，还有一股很淡的、人住的地方才有的气味。",
      "after": "砖整块取出来的那一刻，孔边能感到一股缓缓的气流——温的，带着一点潮，还有一股很淡的气味。",
      "reason": "只保留原通孔时气流、温潮与淡气味的感受，撤出入方向确证；气味来源沿后段限知，不恢复人居独证。",
      "review_v1_paragraph_index_zero_based_including_heading": 22,
      "applied_paragraph_index_zero_based_including_heading": 22,
